generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Empire {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vassals     Nation[] @relation("EmpireVassals")
}

model Nation {
  id              String     @id @default(cuid())
  name            String
  description     String?
  region          String
  isArchived      Boolean    @default(false)
  startYear       Int        @default(1000)
  startPopulation Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  growths         Growth[]
  additions       Addition[]
  empireId        String?
  empire          Empire?    @relation("EmpireVassals", fields: [empireId], references: [id])
  discordRegistration DiscordRegistration?
}

// Links a Discord signup (or a staff-linked legacy nation) to exactly one tracker nation.
model DiscordRegistration {
  id            String    @id @default(cuid())
  applicationId String    @unique
  guildId       String
  memberId      String
  threadId      String?
  nationId      String    @unique
  nation        Nation    @relation(fields: [nationId], references: [id], onDelete: Cascade)
  payloadHash   String?
  source        String    @default("registration")
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([guildId, memberId])
}

model Era {
  id          String     @id @default(cuid())
  name        String
  startYear   Int
  endYear     Int
  startDate   DateTime
  endDate     DateTime
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  growths     Growth[]
  additions   Addition[]
}

model Growth {
  id              String   @id @default(cuid())
  startPopulation Int
  growthRate      Float
  endPopulation   Int
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  nationId        String
  eraId           String
  era             Era      @relation(fields: [eraId], references: [id])
  nation          Nation   @relation(fields: [nationId], references: [id])
}

model Addition {
  id        String   @id @default(cuid())
  amount    Int // The absolute change in population (can be positive or negative)
  year      Int // The year when this addition occurs
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nationId  String
  eraId     String
  era       Era      @relation(fields: [eraId], references: [id])
  nation    Nation   @relation(fields: [nationId], references: [id])
}
